R2_ACCESS_KEY_ID=careerflow
R2_SECRET_ACCESS_KEY=careerflow-local-only
R2_BUCKET=careerflow-private
R2_REGION=auto
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
DOCUMENT_TOKEN_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_WORKER_SHARED_SECRET=replace-with-a-different-random-secret
DOCUMENT_WORKER_REQUEST_SECRET=replace-with-another-random-secret
DOCUMENT_WORKER_URL=http://document-worker:8081
DOCUMENT_CALLBACK_BASE_URL=http://api:8000
DOCUMENT_SOURCE_ORIGINS=http://minio:9000
TURNSTILE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
DEV_AUTH_BYPASS=true
